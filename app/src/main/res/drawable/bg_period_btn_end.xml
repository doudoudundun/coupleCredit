<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFE4EC" />
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="#FFE37D9A" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FFF6F6F6" />
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="#FFE0E0E0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="#FFFF8FA3" />
        </shape>
    </item>
</selector>
