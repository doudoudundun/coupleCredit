<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED">

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:id="@+id/top_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_toolbar"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 搜索栏（默认隐藏，点击搜索图标展开） -->
        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="搜索聊天记录"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:textColorHint="#BBBBBB"
                android:textColor="@color/text_body"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <TextView
                android:id="@+id/btn_search_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="取消"
                android:textColor="#07C160"
                android:textSize="14sp"
                android:padding="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 聊天消息列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_section"
        app:layout_constraintBottom_toTopOf="@id/input_section">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_chat_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 加载新消息指示器 -->
        <LinearLayout
            android:id="@+id/loading_newer_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#E8F5E9"
            android:padding="6dp"
            android:visibility="gone"
            android:elevation="2dp">

            <ProgressBar
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                style="?android:attr/progressBarStyleSmall" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载新消息..."
                android:textSize="12sp"
                android:textColor="#66BB6A" />
        </LinearLayout>

        <!-- 加载历史消息指示器 -->
        <LinearLayout
            android:id="@+id/loading_older_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#E8F5E9"
            android:padding="6dp"
            android:visibility="gone"
            android:elevation="2dp">

            <ProgressBar
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                style="?android:attr/progressBarStyleSmall" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载历史消息..."
                android:textSize="12sp"
                android:textColor="#66BB6A" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部输入区 -->
    <LinearLayout
        android:id="@+id/input_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_toolbar"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 输入行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- 搜索图标 -->
            <ImageView
                android:id="@+id/btn_search_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_chat_search"
                android:padding="6dp"
                android:layout_marginEnd="2dp" />

            <!-- + 展开按钮（无输入时显示） -->
            <ImageView
                android:id="@+id/btn_plus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_add"
                android:padding="6dp"
                android:layout_marginEnd="2dp"
                android:visibility="visible" />

            <!-- 消息输入框 -->
            <EditText
                android:id="@+id/et_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="说点什么..."
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:maxHeight="100dp"
                android:maxLines="4"
                android:minHeight="36dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical"
                android:textSize="15sp"
                android:textColor="@color/text_body"
                android:textColorHint="#BBBBBB" />

            <!-- 发送按钮（有输入时显示） -->
            <ImageView
                android:id="@+id/btn_send"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_chat_send"
                android:background="@drawable/bg_send_btn"
                android:padding="8dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- + 展开的功能面板 -->
        <LinearLayout
            android:id="@+id/action_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_chat_action_panel"
            android:padding="16dp"
            android:gravity="start"
            android:visibility="gone">

            <!-- 拍照 -->
            <LinearLayout
                android:id="@+id/action_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_chat_camera"
                    android:background="@drawable/bg_chat_input"
                    android:padding="10dp"
                    android:elevation="1dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拍照"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- 相册 -->
            <LinearLayout
                android:id="@+id/action_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_image"
                    android:background="@drawable/bg_chat_input"
                    android:padding="10dp"
                    android:elevation="1dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="相册"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
