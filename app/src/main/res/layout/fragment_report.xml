<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="2dp"
    android:gravity="top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="16dp"
        >

        <TextView
            android:id="@+id/tv_month_choose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025年7月 >"
            android:textSize="12dp"
            android:textColor="#333333"
            android:textStyle="bold" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/tv_remainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="结余："
            android:textSize="12dp"
            android:textColor="#333333"
            android:textStyle="bold" />

    </LinearLayout>
    <!-- 分段选择器 -->
    <com.transsion.widgetslib.widget.OSSegmentedTab
        android:id="@+id/segmented_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp" />

    <!-- 收入趋势图表容器 -->
    <LinearLayout
        android:id="@+id/ll_trend_container"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_margin="10dp"
        android:background="@drawable/rounded_card_background"
        android:orientation="vertical"
        android:padding="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_trend_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="收入趋势"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />
        <TextView
            android:id="@+id/tv_total_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总计：￥0.00"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="16dp" />
            
        <!-- 筛选按钮组 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="right">
            
            <!-- 间隔View -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            
            <TextView
                android:id="@+id/tv_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="所有"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:background="@drawable/filter_button_left_selected"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:elevation="2dp" />
                
            <TextView
                android:id="@+id/tv_filter_self"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自己"
                android:textSize="10sp"
                android:textColor="#666666"
                android:background="@drawable/filter_button_middle_unselected"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginLeft="-2dp"
                android:elevation="1dp" />
                
            <TextView
                android:id="@+id/tv_filter_partner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="对方"
                android:textSize="10sp"
                android:textColor="#666666"
                android:background="@drawable/filter_button_middle_unselected"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginLeft="-2dp"
                android:elevation="1dp" />
                
            <TextView
                android:id="@+id/tv_filter_shared"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="共同"
                android:textSize="10sp"
                android:textColor="#666666"
                android:background="@drawable/filter_button_right_unselected"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginLeft="-2dp"
                android:elevation="1dp" />
                
        </LinearLayout>
        </LinearLayout>

        <!-- 这里放置图表视图 -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/trend_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</LinearLayout>