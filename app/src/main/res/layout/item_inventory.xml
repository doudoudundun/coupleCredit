<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_margin="4dp"
    android:minHeight="32dp"
    android:importantForAccessibility="yes"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_card_small"
    app:cardElevation="2dp">

    <!-- InventoryDeckLayoutManager animates this outer item from 88dp to 32dp.
         The full layer below stays fixed at 88dp so its media and actions are
         never measured against the temporary compact height. -->
    <FrameLayout
        android:id="@+id/layout_inventory_card"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/inventory_card_center_surface"
        android:clipChildren="true"
        android:importantForAccessibility="yes">

        <!-- Keep the media/details area above the fixed summary.  The reserved
             bottom space gives every card the same measured height when note or
             expiry metadata is present. -->
        <LinearLayout
            android:id="@+id/layout_inventory_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/layout_inventory_media_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_inventory_image"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/image_placeholder_background"
                    android:contentDescription="物资图片"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_inventory_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_inventory_head_row"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_inventory_category"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/category_tag_background"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="6dp"
                            android:paddingBottom="2dp"
                            android:text="物品名称"
                            android:textColor="@color/primary_color"
                            android:textSize="10sp" />

                        <ImageButton
                            android:id="@+id/btn_more"
                            android:layout_width="30dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="更多操作"
                            android:minWidth="30dp"
                            android:minHeight="28dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_more_vertical"
                            android:tint="@color/text_muted" />
                    </LinearLayout>

                    <!-- All optional metadata shares this fixed-height line so
                         toggling note/expiry never changes card geometry. -->
                    <LinearLayout
                        android:id="@+id/layout_inventory_status_row"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_last_consumed"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="最近更新: 今天 12:00"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tv_note"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="备注"
                            android:textColor="@color/text_disabled"
                            android:textSize="9sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_expiration_status"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="2 天后到期"
                            android:textColor="#F59E0B"
                            android:textSize="9sp"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_consume"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:background="@drawable/button_circle_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="44dp"
                            android:minHeight="24dp"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:text="消耗"
                            android:textColor="@color/primary_color"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_replenish"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/button_circle_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="44dp"
                            android:minHeight="24dp"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:text="补货"
                            android:textColor="@color/brand_green"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- The single title/quantity row sits at the bottom edge.  Deeper cards
             therefore expose useful identity text in their narrow visible strip
             without duplicating either value. -->
        <LinearLayout
            android:id="@+id/layout_inventory_summary"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:background="@drawable/inventory_card_summary_background"
            android:baselineAligned="false"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <View
                android:id="@+id/inventory_summary_marker"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:background="@color/brand_green" />

            <LinearLayout
                android:id="@+id/layout_title_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_inventory_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minLines="1"
                    android:text="存货名称"
                    android:textColor="@color/text_title"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="10 个"
                    android:textColor="@color/text_body"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_low_stock_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/low_stock_badge_background"
                    android:includeFontPadding="false"
                    android:paddingStart="4dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="1dp"
                    android:text="告急"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- This layer is the complete content for a deeper, complete 32dp card.  The
         layout manager controls its alpha and accessibility while scrolling;
         keeping it match_parent makes the two labels vertically centered as
         the outer CardView animates its actual height. -->
    <LinearLayout
        android:id="@+id/layout_inventory_compact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <View
            android:id="@+id/inventory_compact_marker"
            android:layout_width="3dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:background="@color/brand_green" />

        <TextView
            android:id="@+id/tv_inventory_compact_name"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="物品名称"
            android:textColor="@color/text_title"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_inventory_compact_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="10 个"
            android:textColor="@color/text_body"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
