<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_asset_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="#F5F5F5"
        android:scaleType="centerCrop"
        android:minHeight="100dp"
        android:src="@drawable/ic_asset_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_asset_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="物品名称"
            android:textColor="#111111"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_asset_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="持有天数 · 每日花费"
            android:textColor="#888888"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_asset_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="¥0"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_asset_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="在用"
                android:textColor="#4CAF50"
                android:textSize="10sp"
                android:background="@drawable/bg_status_active"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
