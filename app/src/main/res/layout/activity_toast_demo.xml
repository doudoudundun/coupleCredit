<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F5F5">

    <!-- 页面标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自定义Toast演示"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp" />

    <!-- 说明文字 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击下方按钮查看不同类型的自定义Toast效果："
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="24dp" />

    <!-- 普通Toast按钮 -->
    <Button
        android:id="@+id/btn_normal_toast"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="普通Toast"
        android:textSize="16sp"
        android:background="@drawable/rounded_card_background"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <!-- 成功Toast按钮 -->
    <Button
        android:id="@+id/btn_success_toast"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="成功Toast"
        android:textSize="16sp"
        android:textColor="#4CAF50"
        android:background="@drawable/rounded_card_background"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <!-- 错误Toast按钮 -->
    <Button
        android:id="@+id/btn_error_toast"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="错误Toast"
        android:textSize="16sp"
        android:textColor="#F44336"
        android:background="@drawable/rounded_card_background"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <!-- 警告Toast按钮 -->
    <Button
        android:id="@+id/btn_warning_toast"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="警告Toast"
        android:textSize="16sp"
        android:textColor="#FF9800"
        android:background="@drawable/rounded_card_background"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <!-- 信息Toast按钮 -->
    <Button
        android:id="@+id/btn_info_toast"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="信息Toast"
        android:textSize="16sp"
        android:textColor="#2196F3"
        android:background="@drawable/rounded_card_background"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <!-- 使用说明 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="使用方法：\n\n1. 普通Toast：CustomToast.show(context, message)\n2. 成功Toast：CustomToast.showSuccess(context, message)\n3. 错误Toast：CustomToast.showError(context, message)\n4. 警告Toast：CustomToast.showWarning(context, message)\n5. 信息Toast：CustomToast.showInfo(context, message)"
        android:textSize="14sp"
        android:textColor="#888888"
        android:background="@drawable/rounded_card_background"
        android:padding="16dp"
        android:layout_marginTop="24dp"
        android:elevation="1dp" />

</LinearLayout>