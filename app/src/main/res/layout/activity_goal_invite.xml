<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/bg_page">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="共同空间邀请"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_body"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="32dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="12dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_inviter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="对方 邀请你共建"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_body"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_invite_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="共同目标加载占位"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="接受后将建立共同空间，目标与小记仅两人可见"
                android:textSize="12sp"
                android:textColor="@color/text_disabled"
                android:gravity="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_accept_invite"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="接受邀请"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@color/couple_pink"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_decline_invite"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="婉拒"
        android:textSize="16sp"
        android:textColor="@color/text_body"
        android:background="@color/border_light" />
</LinearLayout>
