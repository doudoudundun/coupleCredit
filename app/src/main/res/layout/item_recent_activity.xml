<?xml version="1.0" encoding="utf-8"?>
<!-- 最近活动项布局 -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="140dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/iv_recent_image"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:background="@drawable/image_placeholder_background"
            android:src="@drawable/ic_inventory_placeholder" />

        <TextView
            android:id="@+id/tv_recent_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="存货名称"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tv_recent_change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="新增"
            android:textSize="11sp"
            android:textColor="@color/primary_color"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_recent_quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10 个"
            android:textSize="10sp"
            android:textColor="#999999"
            android:maxLines="1" />

    </LinearLayout>

</androidx.cardview.widget.CardView>