<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 新增的LinearLayout容器，背景参考ll_trend_container -->
    <LinearLayout
        android:id="@+id/ll_additional_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/rounded_card_background"
        android:orientation="vertical"
        android:padding="8dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <TextView
                android:id="@+id/tv_additional_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="支出类目占比"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="0dp" />
                
            <!-- 筛选按钮组 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="0dp"
                android:gravity="right">
                
                <!-- 间隔View -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                
                <TextView
                    android:id="@+id/tv_filter_all_pie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="所有"
                    android:textSize="10sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/filter_button_left_selected"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:elevation="2dp" />
                    
                <TextView
                    android:id="@+id/tv_filter_self_pie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自己"
                    android:textSize="10sp"
                    android:textColor="#666666"
                    android:background="@drawable/filter_button_middle_unselected"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginLeft="-2dp"
                    android:elevation="1dp" />
                    
                <TextView
                    android:id="@+id/tv_filter_partner_pie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="对方"
                    android:textSize="10sp"
                    android:textColor="#666666"
                    android:background="@drawable/filter_button_middle_unselected"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginLeft="-2dp"
                    android:elevation="1dp" />
                    
                <TextView
                    android:id="@+id/tv_filter_shared_pie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="共同"
                    android:textSize="10sp"
                    android:textColor="#666666"
                    android:background="@drawable/filter_button_right_unselected"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginLeft="-2dp"
                    android:elevation="1dp" />
                    
            </LinearLayout>
        </LinearLayout>
            
        <!-- 空心饼状图 -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pie_chart_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="-24dp"
            android:layout_marginBottom="-24dp"/>

    </LinearLayout>

</LinearLayout>