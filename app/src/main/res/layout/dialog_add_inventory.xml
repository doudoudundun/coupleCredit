<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="添加存货"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- 图片区域：小一点的圆角卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_add_image"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@drawable/image_placeholder_background"
            android:src="@drawable/ic_add_image_placeholder" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_select_image"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="选择图片"
                android:textSize="13sp"
                android:textColor="#07C160"
                android:background="@drawable/category_tag_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:drawableStart="@drawable/ic_image"
                android:drawablePadding="4dp" />

            <TextView
                android:id="@+id/tv_ai_generate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="AI生成"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:background="@drawable/category_tag_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:drawableStart="@drawable/ic_ai"
                android:drawablePadding="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 存货名称 -->
    <EditText
        android:id="@+id/et_inventory_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="存货名称"
        android:inputType="text"
        android:maxLines="1"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <!-- 类别 -->
    <Spinner
        android:id="@+id/spinner_add_category"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/spinner_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="10dp" />

    <!-- 数量 + 单位 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/et_quantity"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="数量"
            android:inputType="numberDecimal"
            android:background="@drawable/input_background"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinner_unit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/spinner_background"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:minWidth="80dp" />
    </LinearLayout>

    <!-- 阈值 -->
    <EditText
        android:id="@+id/et_threshold"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="告警阈值（低于此数量提醒）"
        android:inputType="numberDecimal"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <!-- 备注 -->
    <EditText
        android:id="@+id/et_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="备注（可选）"
        android:inputType="textMultiLine"
        android:maxLines="3"
        android:minHeight="44dp"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textSize="14sp"
        android:gravity="top"
        android:layout_marginBottom="16dp" />

    <!-- AI生图提示词 -->
    <EditText
        android:id="@+id/et_ai_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="AI生图提示词（可选）"
        android:inputType="text"
        android:maxLines="2"
        android:minHeight="44dp"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- 提交按钮 -->
    <TextView
        android:id="@+id/btn_add_inventory"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="添加"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:background="@drawable/button_background"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
