<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    tools:context=".fragment.HeadFragment">

    <FrameLayout
        android:id="@+id/fg_change"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:elevation="0dp"
        android:outlineSpotShadowColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/segmented_tab"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- 顶部蒙版遮罩 -->
    <View
        android:id="@+id/top_mask"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/top_gradient_mask"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@+id/top_mask2"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@drawable/top_gradient_mask2"
        android:elevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/top_mask" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/segmented_tab"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/segmented_tab_margin_top"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:elevation="2dp"
        android:background="@drawable/segment_container_background"
        app:tabBackground="@drawable/segment_tab_background"
        app:tabTextAppearance="@style/SegmentTabTextStyle"
        app:tabIndicatorHeight="0dp"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>