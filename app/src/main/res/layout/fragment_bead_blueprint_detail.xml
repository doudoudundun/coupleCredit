<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_blueprint_detail_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="返回"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="#111827" />

                <TextView
                    android:id="@+id/tv_blueprint_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="图纸详情"
                    android:textColor="#111827"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_blueprint_edit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="编辑"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    android:tint="#6B7280" />

                <ImageView
                    android:id="@+id/btn_blueprint_delete"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="删除"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    android:tint="#EF4444" />
            </LinearLayout>

            <com.example.couplecredit.view.BeadGridView
                android:id="@+id/bead_grid_view"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="12dp"
                android:background="#FAFAFA"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_blueprint_detail_total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_card_background"
                    android:padding="12dp"
                    android:text="每次 0 颗"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_blueprint_detail_builds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_card_background"
                    android:padding="12dp"
                    android:text="已制作 0 次"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_blueprint_colors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btn_build_blueprint"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="16dp"
            android:background="@drawable/button_background"
            android:gravity="center"
            android:text="记录制作 1 次"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
