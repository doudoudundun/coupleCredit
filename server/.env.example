# 只监听本机，由 nginx 反代；8080 绝不能对公网开放
# （曾因 0.0.0.0 + trust proxy=1 导致限流可被伪造 X-Forwarded-For 绕过）
HOST=127.0.0.1
# bcrypt 并发闸门（见 src/middleware/bcryptGate.js）：把 CPU 密集的 bcrypt 串行化，
# 避免并发登录吃满 CPU 导致事件循环饥饿、拖垮全站（实测无闸门时降幅 -97.5%）。
# ⚠️ 必须配合并发闸门使用：MAX_CONCURRENT 绝不要 > 1（2 vCPU 下会让两个核都饱和）。
# 单次 bcrypt ≈ 62ms，故闸门吞吐 ≈ 16 rps；能同时登录成功的人数 = MAX_CONCURRENT + MAX_QUEUE。
BCRYPT_MAX_CONCURRENT=1
# 允许排队等待名额的请求数。队列满则立即 429（客户端会提示「登录请求过多，请稍后重试」）。
# 32 个排队最坏约等 2 秒。注意：排队请求会一直占着连接。
BCRYPT_MAX_QUEUE=32
# 排队最长等待毫秒数，超过则 429。
BCRYPT_MAX_WAIT_MS=4000
# 看门狗阈值：名额持有超过该毫秒数视为泄漏并强制回收（正常一次 bcrypt 仅 ~62ms）。
# 兜底用，防止任何未预期异常导致登录功能永久 429。
BCRYPT_HOLD_LIMIT_MS=30000
PORT=8082
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
INVITE_CODE=your-invite-code
BCRYPT_ROUNDS=10
JWT_SECRET=your-jwt-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 账号保险箱字段级加密密钥（AES-256-GCM）。base64 编码，解码后必须为 32 字节。
# 生成方式：openssl rand -base64 32
# 注意：密钥变更后历史密文将无法解密，请妥善保管，不要提交到代码库。
ENCRYPTION_KEY=your-encryption-key-base64

# 微信小程序登录（可选，配置后启用 /api/auth/wechat-login 与 /api/auth/wechat-bind）
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# 微信「消息推送」（内容安全异步回调必需）
# 来源：公众平台 → 开发管理 → 开发设置 → 消息推送
#   URL 填 https://你的域名/api/wechat/callback，Token 与 EncodingAESKey 抄回这里，
#   消息加密方式必须选「安全模式」（本服务拒绝未加密的回调报文，防伪造审核通过）。
#   WECHAT_MSG_TOKEN     自己填的字符串，3~32 位字母或数字，用于校验 msg_signature
#   WECHAT_ENCODING_AES_KEY  点「随机生成」得到的 43 位字符串，用于解密回调报文
# 两个键任一为空，/api/wechat/callback 就返回 503，图片审核结果收不到。
# 写入用：bash scripts/set-wechat-message-push.sh
WECHAT_MSG_TOKEN=
WECHAT_ENCODING_AES_KEY=

# 公网基址：media_check_async 要求 media_url 能被微信的检测服务器下载，
# 服务端用它把 /uploads/xxx 拼成绝对地址。本地开发无法被公网下载时留空即可（跳过头像审核）。
PUBLIC_BASE_URL=https://api.couplecredit.top

