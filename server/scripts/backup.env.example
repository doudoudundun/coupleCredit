# daily-backup.sh 的凭据文件示例。
#
# 生产位置：/etc/couplecredit/backup.env
# 权限必须是 600（含明文口令），且**绝不能提交进仓库**：
#   install -m 600 /dev/null /etc/couplecredit/backup.env
#   install -m 600 backup.env.example /etc/couplecredit/backup.env   # 然后填入真实口令
#
# 推荐用最小权限的备份账号，不要用 root：
#   CREATE USER 'backup'@'localhost' IDENTIFIED BY '<强口令>';
#   GRANT SELECT, LOCK TABLES, SHOW VIEW, EVENT, TRIGGER, PROCESS,
#         RELOAD, REPLICATION CLIENT ON *.* TO 'backup'@'localhost';
#   FLUSH PRIVILEGES;
#
# 若同一文件也要被其他脚本消费，可只放通用键名，或额外提供 MYSQL_PWD。

DB_USER=backup
DB_PASSWORD=replace-with-a-strong-password

# 可选覆盖（不填则用 daily-backup.sh 里的默认值）
# DB_NAME=couple_credit_private
